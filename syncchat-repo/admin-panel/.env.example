# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the service's dashboard instead.

# Render sets PORT automatically. ADMIN_PORT is only used as a fallback
# when running this alongside the main app locally on one machine.
ADMIN_PORT=4000

# Path to the SQLite file this panel reads/writes. Locally this defaults
# to ../random-chat/server/data/syncchat.db (the main app's own file), but
# on Render each service has its own isolated disk — there is no path that
# reaches another service's storage. See DEPLOY.md for how to handle this.
# DB_PATH=/var/data/syncchat.db
