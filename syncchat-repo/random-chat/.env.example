# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the service's dashboard instead — .env is not
# read there.

# Render sets this automatically; only needed locally if you want a
# non-default port.
PORT=3000

# Optional — enables "Continue with Google". If unset, the app just hides
# the Google sign-in button and email/mobile signup still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the URL Render gives you (or your custom domain), e.g.
# https://your-app.onrender.com — used to build the OAuth redirect URI.
OAUTH_BASE_URL=

# Required — Supabase Postgres, POOLED ("Transaction") connection string,
# not the direct one. Project Settings -> Database -> Connection string ->
# Transaction pooler (port 6543).
DATABASE_URL=

# Required — Upstash Redis REST credentials (from your Upstash dashboard,
# NOT the "redis://" TCP URL — the REST URL/token pair).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — horizontal scaling. Leave unset for single-instance mode
# (zero config, works on any free tier). Set this to a Redis TCP URL and
# EVERY instance you run shares one matchmaking pool, one presence map and
# one session store — scale by simply launching more instances behind a
# load balancer. Content still flows peer-to-peer, so each added instance
# only needs to handle lightweight signaling. Works with Upstash (TLS
# URL), a free Oracle Cloud Redis, or any plain Redis 6+.
REDIS_TCP_URL=

# Optional — TURN relay for the small share of users behind symmetric
# NATs/firewalls where a direct peer-to-peer WebRTC path can't be
# established (the app auto-falls back to a server relay for text in that
# case; TURN lets those users connect P2P too). Self-host coturn or use a
# managed provider, then fill these in. TURN only relays encrypted packets
# — it never sees message content.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
