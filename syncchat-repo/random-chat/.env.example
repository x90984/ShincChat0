# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the service's dashboard instead — .env is not
# read there.

# Render sets this automatically; only needed locally if you want a
# non-default port.
PORT=3000

# Optional — enables "Continue with Google". If unset, the app just hides
# the Google sign-in button and email/mobile signup still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the URL Render gives you (or your custom domain), e.g.
# https://your-app.onrender.com — used to build the OAuth redirect URI.
OAUTH_BASE_URL=

# Required — Supabase Postgres, POOLED ("Transaction") connection string,
# not the direct one. Project Settings -> Database -> Connection string ->
# Transaction pooler (port 6543).
DATABASE_URL=

# Required — Upstash Redis REST credentials (from your Upstash dashboard,
# NOT the "redis://" TCP URL — the REST URL/token pair).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
