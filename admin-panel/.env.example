# Copy this file to .env for local development.

PORT=4000

# REQUIRED — the same Postgres the main app uses. On Supabase: the
# "Transaction" pooler connection string (port 6543).
DATABASE_URL=postgres://shinc:shinc@127.0.0.1:5433/shincchat

# Set to false for local/docker Postgres without TLS.
PG_SSL=false
