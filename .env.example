# docker-compose environment — copy to .env and edit.
# Everything with a default works out of the box except SESSION_SECRET.

# REQUIRED — signs login tokens and media URLs. Any long random string:
#   openssl rand -hex 32
# Must be the same on every app replica and must not change between deploys
# (changing it logs everyone out and invalidates media URLs).
SESSION_SECRET=

# Your domain (Caddy fetches a Let's Encrypt cert automatically). Leave unset
# for plain HTTP on port 80 (local testing / behind another proxy).
# DOMAIN=chat.example.com
# ACME_EMAIL=you@example.com

# How many app workers (one per CPU core is a good start; 2 OCPU → 2).
WEB_CONCURRENCY=2

# Postgres password (internal to the compose network).
POSTGRES_PASSWORD=shinc

# Max Postgres connections per worker (× workers must stay under 100 total
# for Postgres's default; compose Postgres allows more, but don't go wild).
PG_POOL_MAX=10

# ---- Optional: media on Cloudflare R2 (recommended before real traffic) ----
# Create a bucket, then generate an S3-style API token in the R2 dashboard.
# Also set a CORS rule allowing PUT/GET from your domain — see SCALING.md.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=shincchat-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Verify clips are ephemeral (never part of chat history) — the app deletes
# media/verify/ objects older than this TTL. Voice messages and profile
# photos are never auto-deleted.
VERIFY_CLIP_TTL_SEC=3600
MEDIA_SWEEP_SEC=300

# ---- Optional: TURN relay for WebRTC video behind strict NATs ----
# Cloudflare Realtime TURN gives 1 TB/month free; copy the TURN URL(s) and
# the token secret here. (coturn's use-auth-secret uses the same scheme.)
# TURN_URLS=turn:turn.cloudflare.com:3478
# TURN_SECRET=
