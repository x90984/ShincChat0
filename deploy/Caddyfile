# Caddy — TLS termination + HTTP/WebSocket load balancing for the app
# workers. WebSockets need no special config in Caddy; upgrades just work.
#
# Set DOMAIN in your .env (e.g. chat.example.com) — Caddy issues and renews
# Let's Encrypt certificates automatically. Leave it unset to serve plain
# HTTP on :80 (local testing).
#
# With multiple app replicas (`docker compose up -d --scale app=4`), Docker's
# DNS returns every replica's IP for the hostname "app", and Caddy load
# balances across them, re-resolving as replicas come and go.
{
	email {$ACME_EMAIL:-admin@example.com}
}

{$DOMAIN::80} {
	encode zstd gzip

	reverse_proxy app:3000 {
		lb_policy round_robin
		health_uri /health
		health_interval 10s
		health_timeout 3s
	}

	header {
		# Tighten the basics; the app itself adds nothing exotic.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
