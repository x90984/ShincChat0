# Copy this file to .env for local development. On hosts (Render, a VM with
# systemd, docker compose) set these as real environment variables instead.

PORT=3000

# ---- Required ----
# Postgres. Local docker-compose provides one; hosted Supabase: use the
# "Transaction" pooler connection string (port 6543), NOT the direct one.
DATABASE_URL=postgres://shinc:shinc@127.0.0.1:5433/shincchat

# Set to false when connecting to a local/plain Postgres (docker compose,
# local dev). Leave unset for Supabase/Render managed Postgres (TLS).
PG_SSL=false

# Signs login sessions + media/upload URLs. REQUIRED in production and for
# any multi-worker deployment. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Realtime state (matching, presence, pairs) ----
# Redis URL. Set it and the app can run any number of workers/machines
# (state.js goes to the redis backend and socket.io uses the redis adapter).
# Leave unset for a single-process, in-memory deployment (e.g. Render free).
REDIS_URL=redis://127.0.0.1:6380

# Workers per machine when started via `npm run start:cluster` (defaults to
# the CPU count). Plain `npm start` always runs exactly one process.
WEB_CONCURRENCY=2

# Optional — enables "Continue with Google". If unset, the button hides and
# email/mobile login still works. See server/oauth.js for the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_BASE_URL=

# Optional — cache backend when there is no local Redis (e.g. Render free).
# Free tier is ~500k commands/month: fine for small deploys, too small for
# busy ones. With REDIS_URL set this is ignored entirely.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — media storage. Any S3-compatible store (Cloudflare R2
# recommended: 10 GB free, zero egress fees). Unset → local MEDIA_DIR.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_DIR=

# Verify clips are ephemeral (relayed live, never part of chat history), so
# uploaded objects under media/verify/ are auto-deleted after this many
# seconds. Default 3600 (1 hour) — plenty for the live flow and the
# consent-gated reveal. Set 0 to disable. Voice messages and profile photos
# are NEVER auto-deleted (they belong to history/profiles).
VERIFY_CLIP_TTL_SEC=3600
# How often the retention sweeper runs (seconds, min 5, default 300).
MEDIA_SWEEP_SEC=300

# Optional — TURN relay for WebRTC video behind strict NATs (mobile
# carriers, strict firewalls). Without it, those users get audio-only/no
# video. Cloudflare Realtime TURN: 1 TB/month free; coturn with
# use-auth-secret works too (same username=timestamp + HMAC scheme).
TURN_URLS=
TURN_SECRET=
TURN_TTL_SEC=86400

# Hide /metrics (default: on). It only exposes counters/gauges, no user data.
# METRICS_ENABLED=false
